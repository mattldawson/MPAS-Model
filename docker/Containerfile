# =============================================================================
# CheMPAS-A build container
# Stage 1: Build dependencies (PnetCDF, NetCDF-C, NetCDF-Fortran, MUSICA)
# Stage 2: Build MPAS-A executables
# =============================================================================

# ---------------------------------------------------------------------------
# Stage 1: deps — PnetCDF + NetCDF + MUSICA
# ---------------------------------------------------------------------------
FROM docker.io/library/fedora:41 AS deps

RUN dnf -y update && dnf -y install \
        autoconf \
        automake \
        cmake \
        curl \
        gcc \
        gcc-c++ \
        gcc-gfortran \
        git \
        hdf5-devel \
        lapack-devel \
        libcurl-devel \
        libtool \
        libxml2-devel \
        m4 \
        make \
        openmpi-devel \
        perl \
        python3 \
        wget \
        zlib-devel \
    && dnf clean all

# OpenMPI env — Fedora installs under /usr/lib64/openmpi
ENV PATH="/usr/lib64/openmpi/bin:${PATH}" \
    LD_LIBRARY_PATH="/usr/lib64/openmpi/lib:${LD_LIBRARY_PATH}" \
    MPI_DIR="/usr/lib64/openmpi"

# ---- PnetCDF ----
ARG PNETCDF_VERSION=1.14.0
RUN cd /tmp \
    && wget -q https://parallel-netcdf.github.io/Release/pnetcdf-${PNETCDF_VERSION}.tar.gz \
    && tar xzf pnetcdf-${PNETCDF_VERSION}.tar.gz \
    && cd pnetcdf-${PNETCDF_VERSION} \
    && ./configure --prefix=/usr/local \
                   --enable-shared \
                   CC=mpicc FC=mpif90 CXX=mpicxx \
    && make -j"$(nproc)" \
    && make install \
    && ldconfig \
    && rm -rf /tmp/pnetcdf-*

ENV PNETCDF=/usr/local

# ---- NetCDF-C ----
ARG NETCDF_C_VERSION=4.9.2
RUN cd /tmp \
    && wget -q https://downloads.unidata.ucar.edu/netcdf-c/${NETCDF_C_VERSION}/netcdf-c-${NETCDF_C_VERSION}.tar.gz \
    && tar xzf netcdf-c-${NETCDF_C_VERSION}.tar.gz \
    && cd netcdf-c-${NETCDF_C_VERSION} \
    && ./configure --prefix=/usr/local \
                   --enable-shared \
                   --enable-pnetcdf \
                   CC=mpicc \
                   CPPFLAGS="-I/usr/local/include" \
                   LDFLAGS="-L/usr/local/lib" \
    && make -j"$(nproc)" \
    && make install \
    && ldconfig \
    && rm -rf /tmp/netcdf-c-*

ENV LD_LIBRARY_PATH="/usr/local/lib:${LD_LIBRARY_PATH}"

# ---- NetCDF-Fortran ----
ARG NETCDF_F_VERSION=4.6.1
RUN cd /tmp \
    && wget -q https://downloads.unidata.ucar.edu/netcdf-fortran/${NETCDF_F_VERSION}/netcdf-fortran-${NETCDF_F_VERSION}.tar.gz \
    && tar xzf netcdf-fortran-${NETCDF_F_VERSION}.tar.gz \
    && cd netcdf-fortran-${NETCDF_F_VERSION} \
    && ./configure --prefix=/usr/local \
                   --enable-shared \
                   CC=mpicc FC=mpif90 \
                   CPPFLAGS="-I/usr/local/include" \
                   LDFLAGS="-L/usr/local/lib" \
    && make -j"$(nproc)" \
    && make install \
    && ldconfig \
    && rm -rf /tmp/netcdf-fortran-*

ENV NETCDF=/usr/local
ENV PKG_CONFIG_PATH="/usr/local/lib/pkgconfig:${PKG_CONFIG_PATH}"

# ---- MUSICA ----
ARG MUSICA_GIT_TAG=main
RUN cd /tmp \
    && git clone --depth 1 --branch ${MUSICA_GIT_TAG} https://github.com/NCAR/musica.git \
    && cd musica \
    && cmake -S . -B build \
             -DCMAKE_BUILD_TYPE=Release \
             -DCMAKE_INSTALL_PREFIX=/usr/local \
             -DMUSICA_BUILD_FORTRAN_INTERFACE=ON \
             -DMUSICA_ENABLE_CARMA=OFF \
    && cmake --build build -j"$(nproc)" \
    && cmake --install build \
    && mkdir -p /usr/local/share/musica/tuvx_data \
    && cp -r /tmp/musica/configs/tuvx/data/cross_sections /usr/local/share/musica/tuvx_data/ \
    && cp -r /tmp/musica/configs/tuvx/data/quantum_yields /usr/local/share/musica/tuvx_data/ \
    && rm -rf /tmp/musica

# ---------------------------------------------------------------------------
# Stage 2: build — compile MPAS-A from source
# ---------------------------------------------------------------------------
FROM deps AS build

WORKDIR /mpas
COPY . .

# Fetch physics externals directly (avoids fragile manage_externals tool)
# rm -rf first in case COPY brought in a prior local checkout
RUN rm -rf src/core_atmosphere/physics/physics_mmm \
    && git clone --depth 1 --branch 20250616-MPASv8.3 \
        https://github.com/NCAR/MMM-physics.git \
        src/core_atmosphere/physics/physics_mmm \
    && rm -rf src/core_atmosphere/physics/physics_noaa/UGWP \
    && mkdir -p src/core_atmosphere/physics/physics_noaa \
    && git clone --depth 1 --branch MPAS_20241223 \
        https://github.com/NOAA-GSL/UGWP.git \
        src/core_atmosphere/physics/physics_noaa/UGWP \
    && rm -rf src/core_atmosphere/physics/physics_wrf/files \
    && mkdir -p src/core_atmosphere/physics/physics_wrf/files \
    && cd src/core_atmosphere/physics/physics_wrf/files \
    && wget -q https://github.com/MPAS-Dev/MPAS-Data/archive/refs/tags/v8.2.tar.gz \
    && tar xzf v8.2.tar.gz --strip-components=4 "MPAS-Data-8.2/atmosphere/physics_wrf/files" \
    && rm v8.2.tar.gz

# No-op the checkout scripts so make doesn't re-run them
RUN printf '#!/bin/sh\nexec true\n' \
        > src/core_atmosphere/tools/manage_externals/checkout_externals \
    && chmod +x src/core_atmosphere/tools/manage_externals/checkout_externals \
    && printf '#!/bin/sh\nexec true\n' \
        > src/core_atmosphere/physics/checkout_data_files.sh \
    && chmod +x src/core_atmosphere/physics/checkout_data_files.sh

# Build init_atmosphere core first (no MUSICA needed), then atmosphere core
# Save init_atmosphere_model before cleaning for the atmosphere build
RUN make -j"$(nproc)" gnu CORE=init_atmosphere USE_PIO2=false \
    && cp init_atmosphere_model /tmp/init_atmosphere_model \
    && make clean CORE=atmosphere \
    && make -j"$(nproc)" gnu CORE=atmosphere USE_PIO2=false \
       MPAS_EXTERNAL_LIBS="$(pkg-config --libs musica-fortran) -lstdc++" \
       MPAS_EXTERNAL_INCLUDES="$(pkg-config --cflags musica-fortran)" \
    && cp /tmp/init_atmosphere_model init_atmosphere_model

# ---------------------------------------------------------------------------
# Stage 3: run — lean runtime image with MPAS executables
# ---------------------------------------------------------------------------
FROM docker.io/library/fedora:41 AS run

RUN dnf -y update && dnf -y install \
        hdf5 \
        openmpi \
        wget \
        zlib \
    && dnf clean all

COPY --from=deps /usr/local /usr/local

ENV PATH="/usr/lib64/openmpi/bin:${PATH}" \
    LD_LIBRARY_PATH="/usr/local/lib:/usr/lib64/openmpi/lib" \
    PNETCDF=/usr/local \
    NETCDF=/usr/local

RUN ldconfig

WORKDIR /mpas
COPY --from=build /mpas/init_atmosphere_model .
COPY --from=build /mpas/atmosphere_model .
COPY --from=build /mpas/chemistry_data chemistry_data/
COPY --from=build /mpas/scripts scripts/

# ---------------------------------------------------------------------------
# Stage 4: dev — interactive development (mount source at runtime)
# ---------------------------------------------------------------------------
FROM docker.io/library/fedora:41 AS dev

RUN dnf -y update && dnf -y install \
        cmake \
        gcc \
        gcc-c++ \
        gcc-gfortran \
        git \
        hdf5-devel \
        lapack-devel \
        libcurl-devel \
        m4 \
        make \
        nco \
        openmpi-devel \
        perl \
        python3 \
        python3-pip \
        python3-numpy \
        python3-netcdf4 \
        python3-matplotlib \
        vim \
        wget \
        zlib-devel \
    && dnf clean all

# Copy installed libraries from deps stage
COPY --from=deps /usr/local /usr/local

# OpenMPI env
ENV PATH="/usr/lib64/openmpi/bin:${PATH}" \
    LD_LIBRARY_PATH="/usr/local/lib:/usr/lib64/openmpi/lib" \
    PNETCDF=/usr/local \
    NETCDF=/usr/local \
    PKG_CONFIG_PATH="/usr/local/lib/pkgconfig"

# Refresh shared library cache
RUN ldconfig

# Verify MUSICA is findable
RUN pkg-config --exists musica-fortran && echo "musica-fortran found" \
    || (echo "ERROR: musica-fortran not found via pkg-config" && exit 1)

WORKDIR /mpas
